<?xml version="1.0" encoding="utf-8"?>
<!-- Smartchain IIS sitesi (K-74). /api ve /api/ws, 127.0.0.1'deki API servisine yönlenir (URL Rewrite + ARR, WebSocket).
     Arayüz dosyaları Aşama 1'de bu klasöre gelir. install.ps1 doldurur. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Smartchain API" stopProcessing="true">
          <match url="^api(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:{{API_PORT}}/{R:0}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <!-- API'nin Türkçe JSON hata cevabı IIS hata sayfasıyla değiştirilmez. -->
    <httpErrors existingResponse="PassThrough" />
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
